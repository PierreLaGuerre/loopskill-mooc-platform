# Server
PORT=3000
NODE_ENV=development

# Authentication
# Use a long random value in production.
JWT_SECRET=change-me-use-a-long-random-secret
JWT_EXPIRES_IN=1h

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mooc_db

# Database SSL
# Local MySQL/MariaDB usually uses DB_SSL=false.
# Managed databases such as AWS RDS can require DB_SSL=true.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_PATH=

# Application defaults
DEFAULT_USER_PLAN_ID=1
FRONTEND_URL=http://localhost:4200

# Stripe test mode
# Use keys from the Stripe Dashboard test environment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# CORS
# Leave empty for open local CORS, or use a comma-separated allowlist:
# FRONTEND_ORIGIN=http://localhost:4200,https://example.com
FRONTEND_ORIGIN=http://localhost:4200
